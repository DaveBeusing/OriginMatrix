{
  "manifest_version": 3,
  "name": "OriginMatrix",
  "version": "0.6.0",
  "minimum_chrome_version": "102",
  "description": "A granular request firewall for the modern web.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "tabs",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "OriginMatrix",
    "default_popup": "src/popup/popup.html"
  }
}
